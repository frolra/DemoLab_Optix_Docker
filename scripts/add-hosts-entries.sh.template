#!/usr/bin/env bash
# Adds the Step CA Demo Lab hostnames to the local /etc/hosts file.
#
# Generated by install.sh for this specific installation - the IP address
# and hostnames below are already filled in, this file is ready to run
# as-is. Re-download it from the Certificate Portal if the lab's
# HOSTNAME_FQDN or HOST_IP ever change.
#
# Usage:
#   sudo ./add-hosts-entries.sh

set -Eeuo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "ERROR: this script must be run as root, e.g. with sudo." >&2
  exit 1
fi

HOSTS_FILE="/etc/hosts"
IP="${HOST_IP}"
HOSTNAMES=(
  "${HOSTNAME_FQDN}"
  "stepca.${HOSTNAME_FQDN}"
  "portainer.${HOSTNAME_FQDN}"
  "keycloak.${HOSTNAME_FQDN}"
  "influxdb.${HOSTNAME_FQDN}"
  "ldapadmin.${HOSTNAME_FQDN}"
  "cloudbeaver.${HOSTNAME_FQDN}"
  "mqtt.${HOSTNAME_FQDN}"
  "mqttws.${HOSTNAME_FQDN}"
  "certificates.${HOSTNAME_FQDN}"
)

START_MARKER="# BEGIN stepca-demo-lab (${HOSTNAME_FQDN})"
END_MARKER="# END stepca-demo-lab (${HOSTNAME_FQDN})"

if [[ ! -f "$HOSTS_FILE" ]]; then
  echo "ERROR: $HOSTS_FILE not found." >&2
  exit 1
fi

BACKUP="${HOSTS_FILE}.bak-$(date +%Y%m%d-%H%M%S)"
cp "$HOSTS_FILE" "$BACKUP"
echo "Backed up existing hosts file to $BACKUP"

TMP_FILE="$(mktemp)"
trap 'rm -f "$TMP_FILE" "${TMP_FILE}.new"' EXIT

# Remove any block this script previously added for this hostname, and
# any other pre-existing line for these hostnames even outside that block
# (e.g. added manually, or by an older run of this script) - otherwise
# those become permanent duplicates.
HOSTNAMES_JOINED="${HOSTNAMES[*]}"
awk -v start="$START_MARKER" -v end="$END_MARKER" -v hostlist="$HOSTNAMES_JOINED" '
  BEGIN {
    n = split(hostlist, arr, " ")
    for (i = 1; i <= n; i++) target[arr[i]] = 1
  }
  $0 == start {skip=1; next}
  $0 == end {skip=0; next}
  skip {next}
  /^[[:space:]]*#/ || NF < 2 {print; next}
  {
    matched = 0
    for (i = 2; i <= NF; i++) {
      if ($i in target) { matched = 1; break }
    }
    if (!matched) print
  }
' "$HOSTS_FILE" > "$TMP_FILE"

{
  cat "$TMP_FILE"
  echo "$START_MARKER"
  for h in "${HOSTNAMES[@]}"; do
    printf '%s\t%s\n' "$IP" "$h"
  done
  echo "$END_MARKER"
} > "${TMP_FILE}.new"

mv "${TMP_FILE}.new" "$HOSTS_FILE"

echo "Added/updated ${#HOSTNAMES[@]} entries in $HOSTS_FILE for $IP"

if command -v resolvectl >/dev/null 2>&1; then
  resolvectl flush-caches || true
elif command -v systemd-resolve >/dev/null 2>&1; then
  systemd-resolve --flush-caches || true
elif command -v dscacheutil >/dev/null 2>&1; then
  dscacheutil -flushcache || true
  killall -HUP mDNSResponder 2>/dev/null || true
fi

echo "Done."
