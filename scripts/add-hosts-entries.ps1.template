#Requires -RunAsAdministrator
<#
    Adds the Step CA Demo Lab hostnames to the local Windows hosts file.

    Generated by install.sh for this specific installation - the IP address
    and hostnames below are already filled in, this file is ready to run
    as-is. Re-download it from the Certificate Portal if the lab's
    HOSTNAME_FQDN or HOST_IP ever change.

    Usage (from an elevated PowerShell prompt):
        .\add-hosts-entries.ps1
#>

$ErrorActionPreference = 'Stop'

$hostsPath = "$env:WinDir\System32\drivers\etc\hosts"
$ip = "${HOST_IP}"
$hostnames = @(
    "${HOSTNAME_FQDN}",
    "stepca.${HOSTNAME_FQDN}",
    "portainer.${HOSTNAME_FQDN}",
    "keycloak.${HOSTNAME_FQDN}",
    "influxdb.${HOSTNAME_FQDN}",
    "ldapadmin.${HOSTNAME_FQDN}",
    "cloudbeaver.${HOSTNAME_FQDN}",
    "mqtt.${HOSTNAME_FQDN}",
    "mqttws.${HOSTNAME_FQDN}",
    "certificates.${HOSTNAME_FQDN}",
    "csr.${HOSTNAME_FQDN}"
)

$startMarker = "# BEGIN stepca-demo-lab (${HOSTNAME_FQDN})"
$endMarker = "# END stepca-demo-lab (${HOSTNAME_FQDN})"

if (-not (Test-Path -Path $hostsPath)) {
    throw "Hosts file not found at $hostsPath"
}

$backup = "$hostsPath.bak-$(Get-Date -Format 'yyyyMMdd-HHmmss')"
Copy-Item -Path $hostsPath -Destination $backup -Force
Write-Host "Backed up existing hosts file to $backup"

$lines = @(Get-Content -Path $hostsPath -ErrorAction SilentlyContinue)
if ($null -eq $lines) { $lines = @() }

# Remove any block this script previously added for this hostname, so
# re-running it (e.g. after HOST_IP changes) does not duplicate entries.
$startIdx = [Array]::IndexOf($lines, $startMarker)
if ($startIdx -ge 0) {
    $endIdx = [Array]::IndexOf($lines, $endMarker)
    if ($endIdx -gt $startIdx) {
        $before = if ($startIdx -gt 0) { $lines[0..($startIdx - 1)] } else { @() }
        $after = if ($endIdx -lt ($lines.Count - 1)) { $lines[($endIdx + 1)..($lines.Count - 1)] } else { @() }
        $lines = @($before) + @($after)
    }
}

# Also drop any other pre-existing line for these hostnames, even outside
# our own marker block (e.g. added manually, or by an older run of this
# script) - otherwise those become permanent duplicates.
$targetSet = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
foreach ($h in $hostnames) { [void]$targetSet.Add($h) }

$lines = @($lines | Where-Object {
    $trimmed = $_.Trim()
    if ($trimmed -eq '' -or $trimmed.StartsWith('#')) { return $true }
    $tokens = $trimmed -split '\s+'
    if ($tokens.Count -lt 2) { return $true }
    for ($i = 1; $i -lt $tokens.Count; $i++) {
        if ($targetSet.Contains($tokens[$i])) { return $false }
    }
    return $true
})

$newBlock = @($startMarker)
foreach ($h in $hostnames) {
    $newBlock += "$ip`t$h"
}
$newBlock += $endMarker

$finalContent = @($lines) + @($newBlock)
Set-Content -Path $hostsPath -Value $finalContent -Encoding ASCII -Force

Write-Host "Added/updated $($hostnames.Count) entries in $hostsPath for $ip"

ipconfig /flushdns | Out-Null
Write-Host "DNS cache flushed. Done."
