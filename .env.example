HOSTNAME_FQDN=CHANGE_ME
HOST_IP=CHANGE_ME
# You can use space remember to write as string inside '' example 'My Test CA'
CA_NAME=CHANGE_ME

STEPCA_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

STEPCA_WEB_SECRET_KEY=CHANGE_ME
PHPLDAPADMIN_APP_KEY=CHANGE_ME
STEPCA_WEB_REPOSITORY='https://github.com/frolra/stepca-web'


# --- v1.1: direct-access bind IPs ---
# Set to a specific VM interface IP to restrict exposure, or leave 0.0.0.0 to
# bind on all interfaces.
POSTGRES_BIND_IP=0.0.0.0
MYSQL_BIND_IP=0.0.0.0
MSSQL_BIND_IP=0.0.0.0
MQTT_BIND_IP=0.0.0.0

# --- Open LDAP Parameters ----
LDAP_ADMIN_PASSWORD=CHANGE_ME
LDAP_INIT_ORG_NAME=CHANGE_ME

# --- Database Parameters ----
# - InfluxDB -
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
# You can use space remember to write as string inside '' example 'My Test Org'
INFLUXDB_ORG=CHANGE_ME

# - PostGres SQL -
POSTGRES_PASSWORD=CHANGE_ME

# -MySQL -
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=CHANGE_ME
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# - Microsoft SQL Server Developer 2022 -
MSSQL_SA_PASSWORD=CHANGE_ME

# --- Mosquitto MQTT ---
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME

# --- CloudBeaver ---
# Auto-provisioned on first start (skips the manual "Configure Server" wizard).
CLOUDBEAVER_ADMIN_USER=CHANGE_ME
CLOUDBEAVER_ADMIN_PASSWORD=CHANGE_ME

# --- Portainer ---
# Auto-provisions the "admin" account on first start (skips the setup-token
# wizard). Must be at least 12 characters; only applies the first time the
# admin account is created (see docs/PORTAINER.md).
PORTAINER_ADMIN_PASSWORD=CHANGE_ME
